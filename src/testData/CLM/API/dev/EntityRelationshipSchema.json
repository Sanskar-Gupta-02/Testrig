{
    "schema": {
        "type": "object",
        "properties": {
            "relationships": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "period": {
                            "type": "object",
                            "properties": {
                                "start": {
                                    "type": "string"
                                },
                                "end": {
                                    "type": ["string", "null"]
                                }
                            },
                            "required": [
                                "start",
                                "end"
                            ]
                        },
                        "relationshipType": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "name"
                            ]
                        },
                        "targetEntity": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "id",
                                "name"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "period",
                        "relationshipType",
                        "targetEntity"
                    ]
                }
            }
        },
        "required": [
            "relationships"
        ]
    }
}
